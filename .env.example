# Retro-TV Environment Configuration
# Copy this file to .env and adjust values for your environment.

# ArenaPulse Sports Dashboard & Kokoro TTS Server URL
# Set this to the URL where your sports-dashboard instance is running.
# Repository & setup instructions: https://github.com/chartmann1590/sports-dashboard
# (e.g. http://localhost:3000 if running locally or via Docker on the same machine)
ARENAPULSE_URL=http://localhost:3000

# Sports Commentary TTS Voices (powered by Kokoro TTS on your sports server)
# Requires running the sports dashboard with the TTS profile:
# docker compose --profile tts up -d
TTS_VOICE_SPORTS=am_michael
TTS_VOICE_SPORTS_NEWS=af_nicole

# To use a remote conversion worker, configure its address here, then select
# "Remote computer only" in Admin Settings. Conversion is off by default.
# RETRO_TV_CLOUD_HOST=user@host-or-address
# RETRO_TV_CLOUD_DIR=/tmp/retro-tv-transcode
