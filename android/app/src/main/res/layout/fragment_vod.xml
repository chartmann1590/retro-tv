<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/retro_bg"
    android:orientation="vertical">

    <!-- VOD Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/retro_surface"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.1"
                android:text="RETROFLIX ON DEMAND"
                android:textColor="@color/retro_amber"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvVodCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/retro_surface_light"
                android:fontFamily="monospace"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="0 TITLES"
                android:textColor="@color/retro_amber"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Filter Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/chipAll"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/retro_amber"
                    android:text="ALL"
                    android:textColor="@color/retro_bg"
                    android:textSize="11sp"
                    app:strokeColor="@color/retro_amber"
                    app:strokeWidth="1dp" />

                <Button
                    android:id="@+id/chipShows"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:text="TV SERIES"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    app:strokeColor="@color/retro_border"
                    app:strokeWidth="1dp" />

                <Button
                    android:id="@+id/chipMovies"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="MOVIES"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    app:strokeColor="@color/retro_border"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshVod"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvVod"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
