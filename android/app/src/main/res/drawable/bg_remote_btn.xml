<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/handset_btn_press" />
            <stroke android:width="1dp" android:color="@color/retro_amber" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/handset_btn" />
            <stroke android:width="1dp" android:color="@color/handset_btn_border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
